  <Identifier>FlexStackerController</Identifier>
  <DisplayName>Flex Stacker Controller</DisplayName>
  <Description>Retrieve and store labware with a Flex Stacker through SiLA 2.</Description>
  <Command>
    <Identifier>RetrieveLabware</Identifier>
    <DisplayName>Retrieve Labware</DisplayName>
    <Description>Retrieve the bottom labware item from the Stacker onto its shuttle.</Description>
    <Observable>Yes</Observable>
    <Parameter>
      <Identifier>LabwareHeight</Identifier>
      <DisplayName>Labware Height</DisplayName>
      <Description></Description>
      <DataType>
        <Constrained>
          <DataType>
            <Basic>Real</Basic>
          </DataType>
          <Constraints>
            <MinimalInclusive>4</MinimalInclusive>
            <MaximalInclusive>102.5</MaximalInclusive>
            <Unit>
              <Label>mm</Label>
              <Factor>0.001</Factor>
              <Offset>0</Offset>
              <UnitComponent>
                <SIUnit>Meter</SIUnit>
                <Exponent>1</Exponent>
              </UnitComponent>
            </Unit>
          </Constraints>
        </Constrained>
      </DataType>
    </Parameter>
    <Parameter>
      <Identifier>EnforceHopperLabwareSensing</Identifier>
